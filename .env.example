# Accounts are on when both values are set (Supabase → Project Settings → API).
# Locally: copy to .env.local. On Vercel: Settings → Environment Variables (all environments).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Food search (USDA FoodData Central, free key from fdc.nal.usda.gov/api-key-signup). Without it: built-in foods only.
# Set in Vercel for all three environments on 2026-10-01; the key is read at build time, so a push is needed after changing it.
NEXT_PUBLIC_USDA_API_KEY=

# ---------- Coach (model) ----------
# Key from openrouter.ai → Keys. Without it the coach gives the built-in answers only.
OPENROUTER_API_KEY=
# Models (src/lib/coach/models.ts). Leave empty for the defaults: questions go to the newest Claude Haiku, then
# Gemini Flash (never DeepSeek: Google's app verification refuses it); whole-plan reviews to the newest Claude Sonnet, then GPT, then Gemini Pro ("~...-latest" OpenRouter aliases).
# A comma-separated list replaces a default list; COACH_MODEL / COACH_MODEL_STRONG put one model in front of it.
COACH_MODELS=
COACH_MODELS_STRONG=
# Questions per athlete per day; default 40.
COACH_DAILY_CAP=

# ---------- Garmin through Junction (junction.com) ----------
# WEARABLE_PROVIDER=junction switches "Connect Garmin" on. Sandbox first, then production keys.
WEARABLE_PROVIDER=
WEARABLE_API_KEY=
# sandbox-us | us | eu | sandbox-eu (Junction region); default sandbox-us
WEARABLE_REGION=
# Signing secret of the webhook endpoint (Junction dashboard → Webhooks → endpoint → Signing secret, starts with whsec_)
WEARABLE_WEBHOOK_SECRET=
# Supabase → Project Settings → API → service_role key. Server only: lets the webhook write activities for any athlete.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Calendar (Profile → Calendar) ----------
# The same OAuth client as Google sign-in (Google Cloud → Google Auth Platform → Clients → "Velocity website").
# Its redirect URIs must include https://www.velocityathletes.com/api/connect/google-calendar/callback (and the
# non-www and localhost:3000 versions). Both values set = "Connect Google Calendar" is on. SQL: supabase/schema-calendar.sql
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a separate secret for encrypting the stored Google tokens. Default: derived from GOOGLE_CLIENT_SECRET,
# so changing that secret means athletes connect Google Calendar again.
CALENDAR_TOKEN_KEY=

# ---------- Outlook (Profile → Calendar) ----------
# A free app registration at portal.azure.com → Microsoft Entra ID → App registrations → New registration.
# Supported accounts: "Any Entra ID tenant + personal Microsoft accounts". Redirect URI (Web):
# https://www.velocityathletes.com/api/connect/outlook/callback (and http://localhost:3000/api/connect/outlook/callback).
# API permissions (Microsoft Graph, delegated): openid, email, offline_access, Calendars.ReadWrite.
# Certificates & secrets → New client secret: paste its Value below. Both set = "Connect Outlook" is on.
# The stored Microsoft keys are encrypted with CALENDAR_TOKEN_KEY (or the Google secret, as above).
# SQL: supabase/schema-calendar-accounts.sql
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Apple Calendar (Profile → Calendar) ----------
# Nothing to register: athletes enter their Apple ID and an app-specific password, encrypted like the keys above.
# On whenever CALENDAR_TOKEN_KEY or GOOGLE_CLIENT_SECRET is set. Optional override for tests only:
# APPLE_CALDAV_URL=http://localhost:4013/
