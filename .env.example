# Accounts are on when both values are set (Supabase → Project Settings → API).
# Locally: copy to .env.local. On Vercel: Settings → Environment Variables (all environments).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Food search (USDA FoodData Central, free key from fdc.nal.usda.gov/api-key-signup). Without it: built-in foods only.
# Set in Vercel for all three environments on 2026-10-01; the key is read at build time, so a push is needed after changing it.
NEXT_PUBLIC_USDA_API_KEY=

# ---------- Coach (model) ----------
# Key from openrouter.ai → Keys. Without it the coach gives the built-in answers only.
OPENROUTER_API_KEY=
# Models (src/lib/coach/models.ts). Leave empty for the defaults: questions go to DeepSeek, then the newest Gemini
# Flash; whole-plan reviews to the newest Claude Sonnet, then GPT, then Gemini Pro ("~...-latest" OpenRouter aliases).
# A comma-separated list replaces a default list; COACH_MODEL / COACH_MODEL_STRONG put one model in front of it.
COACH_MODELS=
COACH_MODELS_STRONG=
# Questions per athlete per day; default 40.
COACH_DAILY_CAP=

# ---------- Garmin through Junction (junction.com) ----------
# WEARABLE_PROVIDER=junction switches "Connect Garmin" on. Sandbox first, then production keys.
WEARABLE_PROVIDER=
WEARABLE_API_KEY=
# sandbox-us | us | eu | sandbox-eu (Junction region); default sandbox-us
WEARABLE_REGION=
# Signing secret of the webhook endpoint (Junction dashboard → Webhooks → endpoint → Signing secret, starts with whsec_)
WEARABLE_WEBHOOK_SECRET=
# Supabase → Project Settings → API → service_role key. Server only: lets the webhook write activities for any athlete.
SUPABASE_SERVICE_ROLE_KEY=
